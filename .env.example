# mock | local | gemini | wavespeed. local edits on this Mac with no key; mock is for tests.
EDITOR_PROVIDER=local
OCR_MODE=rapid
APP_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string
# A Neon postgres:// URL, or a folder (data/pglite) for an offline local database.
DATABASE_URL=data/pglite

# Optional. Only read when EDITOR_PROVIDER=gemini. A Gemini chat subscription is not this key.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional. About $0.04 per successful test image.
WAVESPEED_API_KEY=
WAVESPEED_EDIT_MODEL=wavespeed-ai/flux-kontext-pro

# Optional. Test mode only. The $5 pack is a fixture, not a launch price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK=
